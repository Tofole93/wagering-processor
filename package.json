{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Jungle Gaming backend challenge - Distributed Wagering Processor",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bunx tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
